# Required for real pipeline runs (transcription + vision + synthesis)
OPENROUTER_API_KEY=

# Optional OpenRouter overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# OPENROUTER_SYNTHESIS_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=competitor-shot-list

# Pipeline tuning (defaults match Implementation Spec v1)
# VISION_BACKEND=openrouter
# TRANSCRIPT_BACKEND=openrouter
# TRANSCRIPT_BACKEND=whisper   # local faster-whisper (offline)
# TRANSCRIPT_BACKEND=stub      # CI mock analyze (no STT)
# TRANSCRIPTION_MAX_RETRIES=8
# VISION_REQUEST_DELAY_SEC=2.0
# VISION_MAX_RETRIES=8
# VISION_CONCURRENCY=1
# SYNTHESIS_MAX_RETRIES=3
# FRAME_INTERVAL_SEC=1.0
# MAX_VIDEO_DURATION_SEC=55
# WHISPER_MODEL=small
# WHISPER_COMPUTE_TYPE=int8
# OUTPUT_DIR=./output
# SCRATCH_DIR=/tmp/shotlist
# JOB_TIMEOUT_SEC=1800

# HTTP server (when FastAPI is wired)
# HOST=0.0.0.0
# PORT=8000

# Slack (optional)
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
